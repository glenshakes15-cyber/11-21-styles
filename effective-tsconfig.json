{
    "compilerOptions": {
        "target": "es2017",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "baseUrl": "./",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "allowSyntheticDefaultImports": true,
        "resolvePackageJsonExports": true,
        "resolvePackageJsonImports": true,
        "preserveConstEnums": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strictBindCallApply": true,
        "strictPropertyInitialization": true,
        "strictBuiltinIteratorReturn": true,
        "alwaysStrict": true,
        "useUnknownInCatchVariables": true
    },
    "files": [
        "./next-env.d.ts",
        "./neon.ts",
        "./next.config.ts",
        "./prisma.config.ts",
        "./prisma/seed.ts",
        "./src/app/api/auth/[...nextauth]/route.ts",
        "./src/app/api/auth/register/route.ts",
        "./src/app/api/feedback/route.ts",
        "./src/app/api/orders/route.ts",
        "./src/app/api/products/route.ts",
        "./src/app/api/products/[id]/route.ts",
        "./src/generated/prisma/browser.ts",
        "./src/generated/prisma/client.ts",
        "./src/generated/prisma/commonInputTypes.ts",
        "./src/generated/prisma/enums.ts",
        "./src/generated/prisma/models.ts",
        "./src/generated/prisma/internal/class.ts",
        "./src/generated/prisma/internal/prismaNamespace.ts",
        "./src/generated/prisma/internal/prismaNamespaceBrowser.ts",
        "./src/generated/prisma/models/Account.ts",
        "./src/generated/prisma/models/Feedback.ts",
        "./src/generated/prisma/models/NotificationPreference.ts",
        "./src/generated/prisma/models/Order.ts",
        "./src/generated/prisma/models/OrderEvent.ts",
        "./src/generated/prisma/models/OrderItem.ts",
        "./src/generated/prisma/models/PasswordResetToken.ts",
        "./src/generated/prisma/models/Payment.ts",
        "./src/generated/prisma/models/Product.ts",
        "./src/generated/prisma/models/SecurityEvent.ts",
        "./src/generated/prisma/models/Session.ts",
        "./src/generated/prisma/models/SiteConfig.ts",
        "./src/generated/prisma/models/User.ts",
        "./src/generated/prisma/models/WebAuthnChallenge.ts",
        "./src/generated/prisma/models/WebAuthnCredential.ts",
        "./src/lib/auth.ts",
        "./src/lib/prisma.ts",
        "./app/layout.tsx",
        "./app/page.tsx",
        "./src/app/layout.tsx",
        "./src/app/page.tsx",
        "./src/app/cart/page.tsx",
        "./src/app/checkout/page.tsx",
        "./src/app/login/page.tsx",
        "./src/app/profile/page.tsx",
        "./src/app/shop/page.tsx",
        "./src/app/shop/[id]/page.tsx",
        "./src/app/signup/page.tsx",
        "./.next/types/cache-life.d.ts",
        "./.next/types/root-params.d.ts",
        "./.next/types/routes.d.ts",
        "./.next/types/validator.ts"
    ],
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts",
        "**/*.mts"
    ],
    "exclude": [
        "node_modules"
    ]
}
